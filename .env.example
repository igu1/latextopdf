# Copy to .env and edit. Read by src/config.py (python-dotenv) for local runs,
# and by docker compose for both the port mapping and the container's env.
#
#   cp .env.example .env

# Port the service listens on (inside the container when using Docker).
PORT=5000

# Interface to bind. Leave 0.0.0.0 for Docker; 127.0.0.1 keeps a local run
# off the network.
HOST=0.0.0.0

# Docker only: the port published on your machine. Defaults to 5055 because the
# portal's ASP.NET process already owns 127.0.0.1:5000 on Windows.
HOST_PORT=5055
